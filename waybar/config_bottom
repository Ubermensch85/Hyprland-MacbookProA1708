{
  // Waybar su layer top e in basso
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "spacing": 0,

  // Moduli: sinistra (azioni rapide), centro (titolo finestra), destra (sistema)
  "modules-left": [
    "custom/command"
  ],

  "modules-center": [
    "custom/window_title"
],

"custom/window_title": {
    "exec": "hyprctl activewindow -j 2>/dev/null | jq -r 'if .class and .class != \"\" then \"[ \\(.class) ]\" else empty end'",
    "interval": 1,
    "format": "{}",
    "escape": true
},


  "modules-right": [
    "disk",
    "custom/pacman"
  ],

  // --- Moduli e impostazioni ---

  "custom/command": {
    "format": "",
    "on-click": "$HOME/scripts/rofi-power.sh",
    "tooltip": false
  },


  "disk": {
    "interval": 30,
    "format": "SSD [{percentage_used}%]",
    "path": "/",
    "on-click": "xdg-open / ; pkill -USR1 waybar",
    "tooltip-format": "/ — {used}/{total} ({percentage_used}%)"
  },

  "custom/pacman": {
    "format": "PACMAN [{}]",
    "interval": 60,
    "exec": "checkupdates 2>/dev/null | wc -l | tr -d '\n' || echo 0",
    "exec-if": "which checkupdates",
    "on-click": "footclient --override=colors.background=000000 --override=colors.foreground=FFFFFF --title=fly-foot-write sudo pacman -Syu ; pkill -USR1 waybar",
    "signal": 1,
    "tooltip": false
  },

  // Facoltativi: tienili pronti, ma disattivi finché non servono
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "ACTIVATED",
      "deactivated": "DEACTIVATED"
    }
  },

  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "cpu": {
    "format": "[CPU {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": "RAM {}%"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": "TEMP {temperatureC}°C",
    "format-icons": [ "", "", "" ],
    "tooltip": false
  },

  "custom/crypto": {
    "format": "{}",
    "interval": 600,
    "return-type": "json",
    "exec": "~/.config/waybar/modules/crypto/waybar_crypto.py",
    "exec-if": "ping pro-api.coinmarketcap.com -c1",
    "on-click": "firefox --new-tab https://it.tradingview.com"
  },

  "custom/vpn": {
    "format": "{}",
    "exec": "rofi-nordvpn -s",
    "interval": 5,
    "on-click": "rofi-nordvpn &",
    "tooltip": false
  },

  "user": {
    "format": "UPTIME [{work_d}D {work_H}H {work_M}M]",
    "interval": 60,
    "avatar": "/home/mm/pics/icons/face1.png",
    "height": 28,
    "width": 28,
    "icon": false,
    "open-on-click": true,
    "open-path": "home/mm/"
  },

  "custom/write": {
    "format": "README",
    "on-click": "footclient --title=fly-foot-write --override=colors.background=A0D7F2 micro $HOME/Documents/dotfiles/macbook-pro-13-intel/README",
    "tooltip": false
  }
}
